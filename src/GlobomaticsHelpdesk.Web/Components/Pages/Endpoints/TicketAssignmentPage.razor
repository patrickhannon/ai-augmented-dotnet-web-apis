@page "/tickets/assignment"
@rendermode InteractiveServer
@inject HelpdeskApiClient Api
@inject ApiKeyState State

<EndpointPage Title="Reassign ticket"
              Method="PATCH" Path="/api/tickets/{id}/assignment"
              Description="Reassign a ticket. Agents may only assign to themselves or unassign; admins may assign to any agent.">

    <div class="row g-2 align-items-end">
        <div class="col-md-6">
            <label class="form-label">Ticket id (Guid)</label>
            <input class="form-control" @bind="_id" />
        </div>
        <div class="col-md-6">
            <label class="form-label">Assigned agent id (Guid, blank to unassign)</label>
            <input class="form-control" @bind="_agentId" />
        </div>
        <div class="col-12 text-end mt-2">
            <button class="btn btn-primary" @onclick="Send" disabled="@(_busy || string.IsNullOrWhiteSpace(_id))">
                @(_busy ? "Sending..." : "Send")
            </button>
        </div>
    </div>

    <div class="mt-3">
        <ResponseViewer Response="_response" />
    </div>
</EndpointPage>

@code {
    private string? _id;
    private string? _agentId;
    private ApiResponse? _response;
    private bool _busy;

    private async Task Send()
    {
        _busy = true;
        try
        {
            var url = $"/api/tickets/{Uri.EscapeDataString(_id ?? string.Empty)}/assignment";
            var body = new Dictionary<string, object?>
            {
                ["assignedAgentId"] = string.IsNullOrWhiteSpace(_agentId) ? null : _agentId,
            };
            _response = await Api.SendAsync(HttpMethod.Patch, url, State.CurrentKey, body);
        }
        finally
        {
            _busy = false;
        }
    }
}
