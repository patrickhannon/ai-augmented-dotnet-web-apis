@page "/tickets/comments"
@rendermode InteractiveServer
@inject HelpdeskApiClient Api
@inject ApiKeyState State

<EndpointPage Title="Add comment"
              Method="POST" Path="/api/tickets/{id}/comments"
              Description="Adds a comment (or internal note) to a ticket. Requires agent or admin role.">

    <div class="row g-2">
        <div class="col-md-8">
            <label class="form-label">Ticket id (Guid)</label>
            <input class="form-control" @bind="_id" />
        </div>
        <div class="col-md-4 d-flex align-items-end">
            <div class="form-check">
                <input id="isInternal" type="checkbox" class="form-check-input" @bind="_isInternal" />
                <label for="isInternal" class="form-check-label">Internal note</label>
            </div>
        </div>
        <div class="col-12">
            <label class="form-label">Body</label>
            <textarea class="form-control" rows="4" @bind="_body"></textarea>
        </div>
        <div class="col-12 text-end mt-2">
            <button class="btn btn-primary" @onclick="Send" disabled="@(_busy || string.IsNullOrWhiteSpace(_id))">
                @(_busy ? "Sending..." : "Send")
            </button>
        </div>
    </div>

    <div class="mt-3">
        <ResponseViewer Response="_response" />
    </div>
</EndpointPage>

@code {
    private string? _id;
    private string? _body = "Looking into this now.";
    private bool _isInternal;
    private ApiResponse? _response;
    private bool _busy;

    private async Task Send()
    {
        _busy = true;
        try
        {
            var url = $"/api/tickets/{Uri.EscapeDataString(_id ?? string.Empty)}/comments";
            var payload = new { body = _body, isInternalNote = _isInternal };
            _response = await Api.SendAsync(HttpMethod.Post, url, State.CurrentKey, payload);
        }
        finally
        {
            _busy = false;
        }
    }
}
