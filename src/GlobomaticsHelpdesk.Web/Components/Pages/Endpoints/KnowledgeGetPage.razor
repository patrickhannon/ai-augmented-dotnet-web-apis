@page "/knowledge/get"
@rendermode InteractiveServer
@inject HelpdeskApiClient Api
@inject ApiKeyState State

<EndpointPage Title="Get knowledge article"
              Method="GET" Path="/api/knowledge/{id}"
              Description="Get a knowledge base article by id.">

    <div class="row g-2 align-items-end">
        <div class="col-md-8">
            <label class="form-label">Article id (Guid)</label>
            <input class="form-control" @bind="_id" />
        </div>
        <div class="col-md-4 text-end">
            <button class="btn btn-primary" @onclick="Send" disabled="@(_busy || string.IsNullOrWhiteSpace(_id))">
                @(_busy ? "Sending..." : "Send")
            </button>
        </div>
    </div>

    <div class="mt-3">
        <ResponseViewer Response="_response" />
    </div>
</EndpointPage>

@code {
    private string? _id;
    private ApiResponse? _response;
    private bool _busy;

    private async Task Send()
    {
        _busy = true;
        try
        {
            var url = $"/api/knowledge/{Uri.EscapeDataString(_id ?? string.Empty)}";
            _response = await Api.SendAsync(HttpMethod.Get, url, State.CurrentKey);
        }
        finally
        {
            _busy = false;
        }
    }
}
