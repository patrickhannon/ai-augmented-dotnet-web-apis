@page "/tickets/list"
@rendermode InteractiveServer
@inject HelpdeskApiClient Api
@inject ApiKeyState State

<EndpointPage Title="List tickets"
              Method="GET" Path="/api/tickets"
              Description="Lists tickets with optional filters. Any authenticated role.">

    <div class="row g-2 align-items-end">
        <div class="col-md-3">
            <label class="form-label">Status</label>
            <select class="form-select" @bind="_status">
                <option value="">(any)</option>
                <option value="0">New (0)</option>
                <option value="1">Open (1)</option>
                <option value="2">Pending (2)</option>
                <option value="3">Resolved (3)</option>
                <option value="4">Closed (4)</option>
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label">Priority</label>
            <select class="form-select" @bind="_priority">
                <option value="">(any)</option>
                <option value="0">Low (0)</option>
                <option value="1">Normal (1)</option>
                <option value="2">High (2)</option>
                <option value="3">Urgent (3)</option>
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label">Assigned agent id (Guid)</label>
            <input class="form-control" @bind="_assignedAgentId" placeholder="guid or empty" />
        </div>
        <div class="col-md-3">
            <label class="form-label">Keyword (q)</label>
            <input class="form-control" @bind="_q" />
        </div>
        <div class="col-md-2">
            <label class="form-label">Page</label>
            <input type="number" class="form-control" @bind="_page" min="1" />
        </div>
        <div class="col-md-2">
            <label class="form-label">Page size</label>
            <input type="number" class="form-control" @bind="_pageSize" min="1" max="200" />
        </div>
        <div class="col-md-8 text-end">
            <button class="btn btn-primary" @onclick="Send" disabled="@_busy">
                @(_busy ? "Sending..." : "Send")
            </button>
        </div>
    </div>

    <div class="mt-3">
        <ResponseViewer Response="_response" />
    </div>
</EndpointPage>

@code {
    private string? _status;
    private string? _priority;
    private string? _assignedAgentId;
    private string? _q;
    private int _page = 1;
    private int _pageSize = 25;
    private ApiResponse? _response;
    private bool _busy;

    private async Task Send()
    {
        _busy = true;
        try
        {
            var qs = new List<string>();
            if (!string.IsNullOrWhiteSpace(_status)) qs.Add($"status={Uri.EscapeDataString(_status)}");
            if (!string.IsNullOrWhiteSpace(_priority)) qs.Add($"priority={Uri.EscapeDataString(_priority)}");
            if (!string.IsNullOrWhiteSpace(_assignedAgentId)) qs.Add($"assignedAgentId={Uri.EscapeDataString(_assignedAgentId)}");
            if (!string.IsNullOrWhiteSpace(_q)) qs.Add($"q={Uri.EscapeDataString(_q)}");
            qs.Add($"page={_page}");
            qs.Add($"pageSize={_pageSize}");

            var url = "/api/tickets?" + string.Join('&', qs);
            _response = await Api.SendAsync(HttpMethod.Get, url, State.CurrentKey);
        }
        finally
        {
            _busy = false;
        }
    }
}
